# PostgreSQL (Compose maps host 5433 -> container 5432)
DATABASE_URL=postgresql://vehicle:vehicle@localhost:5433/vehiclecontact?schema=public

# Better Auth (generate: openssl rand -base64 32)
AUTH_SECRET=
BETTER_AUTH_SECRET=

# Public origin encoded into QR stickers
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Abuse / messaging (used from Phase 10 / 13)
MESSAGE_MAX_CHARS=500
RATE_LIMIT_VISITOR_PER_MINUTE=5

# Owner notifications (Phase 12)
# Email: optional. Without a key, notifications are logged to the server console instead of sent.
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=
# Browser push: required for push to work. Generate your own pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Google sign-in (Cloud Console -> APIs & Services -> Credentials -> OAuth client ID -> Web application)
# Authorized redirect URI must be: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
# The "Continue with Google" button stays hidden until these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# S3-compatible object storage (Neon object storage / any S3 API). Server-side only.
# Without these, downloads stream inline instead of via pre-signed URLs.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
