# PostgreSQL (Compose maps host 5433 -> container 5432)
DATABASE_URL=postgresql://vehicle:vehicle@localhost:5433/vehiclecontact?schema=public

# Better Auth (generate: openssl rand -base64 32)
AUTH_SECRET=
BETTER_AUTH_SECRET=

# Public origin encoded into QR stickers
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Abuse / messaging (used from Phase 10 / 13)
MESSAGE_MAX_CHARS=500
RATE_LIMIT_VISITOR_PER_MINUTE=5

# Optional later
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
