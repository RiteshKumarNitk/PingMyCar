generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth tables (required by the Prisma adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// Owner phone for OTP login. Never shown on public profiles.
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  preferredName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  accounts Account[]
  sessions Session[]
  vehicles Vehicle[]
  devices  Device[]
  notifications Notification[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

enum VehicleType {
  CAR
  BIKE
  SCOOTER
  TRUCK
  VAN
  OTHER
}

enum ContactReason {
  LIGHTS_ON
  MOVE_VEHICLE
  DOOR_OPEN
  VEHICLE_ISSUE
  DAMAGE
  SECURITY
  URGENT
  OTHER
}

enum ConversationStatus {
  OPEN
  CLOSED
  BLOCKED
}

enum SenderType {
  VISITOR
  OWNER
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

model Vehicle {
  id                 String       @id @default(uuid())
  ownerId            String
  type               VehicleType?
  name               String
  /// Private unless VehicleProfile.showRegistrationNumber is true.
  registrationNumber String?
  photoUrl           String?
  /// QR encodes NEXT_PUBLIC_APP_URL/v/<publicToken> only.
  publicToken        String       @unique
  qrActive           Boolean      @default(true)
  /// Vehicle color — shown on the vehicle's public page only if the owner
  /// enables showVehicleColor. Not collected anywhere else.
  color              String?
  /// Incremented when a visitor opens the public vehicle page.
  scanCount          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt

  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  profile       VehicleProfile?
  conversations Conversation[]

  @@index([ownerId])
}

model VehicleProfile {
  id     String @id @default(uuid())
  vehicleId String @unique

  showVehicleName         Boolean @default(true)
  showVehicleType         Boolean @default(true)
  showVehiclePhoto        Boolean @default(true)
  showRegistrationNumber  Boolean @default(false)
  showOwnerName           Boolean @default(false)
  showOwnerPhoto          Boolean @default(false)
  showPreferredName       Boolean @default(false)

  allowMessages           Boolean @default(true)
  allowParkingAlerts      Boolean @default(true)
  allowVehicleIssues      Boolean @default(true)
  allowDamageReports      Boolean @default(true)
  allowEmergencyAlerts    Boolean @default(true)
  /// Stored for later. Not implemented in MVP.
  allowCallRequest        Boolean @default(false)
  allowWhatsApp           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Conversation {
  id               String             @id @default(uuid())
  vehicleId        String
  /// SHA-256 of the visitor URL token. Raw token is never stored.
  visitorTokenHash String             @unique
  reason           ContactReason
  status           ConversationStatus @default(OPEN)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
  expiresAt        DateTime

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  messages Message[]
  reports  Report[]

  @@index([vehicleId, createdAt])
  /// Inbox ordering: an owner's conversations, most recently active first.
  @@index([vehicleId, updatedAt])
  /// Owner inbox filter: unread threads include unseen VISITOR messages.
  @@index([vehicleId, status])
}

model Report {
  id             String   @id @default(uuid())
  conversationId String
  reason         String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Message {
  id             String         @id @default(uuid())
  conversationId String
  senderType     SenderType
  reason         ContactReason?
  body           String
  createdAt      DateTime       @default(now())
  /// When the owner first viewed this message in the dashboard.
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  /// Unread badges: count VISITOR messages where readAt IS NULL without a
  /// table scan as message volume grows.
  @@index([conversationId, senderType, readAt])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  /// The conversation whose activity raised this notification (null for
  /// account-level notices).
  messageId  String?
  type       String
  /// Payload snapshot shown in a future in-app notification list.
  title      String
  body       String
  url        String?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Device {
  id        String         @id @default(uuid())
  userId    String
  fcmToken  String         @unique
  platform  DevicePlatform @default(WEB)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
